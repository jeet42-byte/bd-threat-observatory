# Copy to .env and fill in. Never commit .env.

# Async Postgres URL (Neon in production).
# Local dev example:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bd_threat_obs

# development | production
ENVIRONMENT=development

# Ingestion tuning (optional; defaults in config.py)
# CT_HTTP_TIMEOUT=30
# CT_MAX_RESULTS_PER_BRAND=1000
# CT_RECENT_DAYS=7
